        <mxCell id="TkDbEDfpusLMQh16LgH8-16" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="A vehicle cannot be in two rentals with overlapping dates." vertex="1">
