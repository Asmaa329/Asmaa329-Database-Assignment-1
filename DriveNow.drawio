        <mxCell id="7Irn46h-RqsZyk3exOB6-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;br&gt; 7.7&amp;amp;7.8&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
