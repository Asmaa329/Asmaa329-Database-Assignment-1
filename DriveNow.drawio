        <mxCell id="TkDbEDfpusLMQh16LgH8-19" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;p dir=&quot;ltr&quot; id=&quot;p-rc_109e1b9c0e11edb4-263&quot;&gt;A corporate rental must name a main driver, and an individual rental must not.&lt;/p&gt;" vertex="1">
          <mxGeometry height="97.5" width="260" x="40" y="357.5" as="geometry" />
        </mxCell>
        <mxCell id="TkDbEDfpusLMQh16LgH8-21" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;gradientColor=#7ea6e0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 9pt; font-family: Helvetica-Bold; font-weight: bold;&quot;&gt;SRS section&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="60" x="-20" as="geometry" />
        </mxCell>
        <mxCell id="TkDbEDfpusLMQh16LgH8-22" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;gradientColor=#7ea6e0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 8.79932pt; font-family: &amp;quot;Liberation Sans&amp;quot;; font-weight: bold; color: rgb(0, 0, 0);&quot;&gt;Business rule&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="260" x="40" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-23" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=#7ea6e0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 9pt; font-family: Helvetica-Bold; font-weight: bold;&quot;&gt;How to enforce it&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="220" x="557" as="geometry" />
        </mxCell>
        <mxCell id="TkDbEDfpusLMQh16LgH8-20" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;gradientColor=#7ea6e0;" value="&lt;span style=&quot;font-family: Helvetica-Bold; font-weight: 700;&quot;&gt;#&amp;nbsp; &amp;nbsp;&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="40" x="-50" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-24" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="BEFORE INSERT trigger on VEHICLETRANSFER that compares FromBranch with the ToBranch of the vehicle’s latest transfer (or its HomeBranch if none) and rejects if different." vertex="1">
          <mxGeometry height="97.5" width="220" x="557" y="65" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-29" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="Stored procedure or BEFORE INSERT trigger on RESERVATION that counts previous uses and compares the reservation date with ValidFrom/ValidTo." vertex="1">
          <mxGeometry height="97.5" width="220" x="557" y="552.5" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-28" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="BEFORE INSERT trigger on LOYALTYTRANSACTION that computes the balance and rejects a Redeemed row above it; the tier is returned by a view using the 1,000 and 5,000 thresholds." vertex="1">
          <mxGeometry height="97.5" width="220" x="557" y="455" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-27" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="BEFORE INSERT trigger on RENTAL that reads the customer’s type and validates MainDriverNo (NULL for individual, NOT NULL for corporate)." vertex="1">
          <mxGeometry height="97.5" width="220" x="557" y="357.5" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-26" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="BEFORE INSERT/UPDATE trigger on RENTAL that searches for an overlapping rental for the same VehicleID, or a stored procedure used by the check-out screen." vertex="1">
          <mxGeometry height="97.5" width="220" x="557" y="260" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-25" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="BEFORE INSERT trigger on RESERVATION and RENTAL that checks the customer’s blacklist record, or the same check in application logic during booking and check-out." vertex="1">
          <mxGeometry height="97.5" width="220" x="557" y="162.5" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-30" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;gradientColor=#7ea6e0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 9pt; font-family: Helvetica-Bold; font-weight: bold;&quot;&gt;Why constraints are not enough&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="260" x="300" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-34" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="CHECK(FromBranch &amp;lt;&amp;gt; ToBranch) sees one row only; it cannot read the vehicle’s previous transfers to know its current branch." vertex="1">
          <mxGeometry height="97.5" width="260" x="300" y="65" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-33" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="Counting existing uses is an aggregate over RESERVATION; CHECK cannot count rows in other tables." vertex="1">
          <mxGeometry height="97.5" width="260" x="300" y="552.5" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-32" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="The balance is a SUM over all rows of LOYALTYTRANSACTION; CHECK works on one row only, and the tier is not stored." vertex="1">
          <mxGeometry height="97.5" width="260" x="300" y="455" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-31" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="The rule depends on the customer’s type, which is stored in another table (CUSTOMER), so a CHECK cannot read it." vertex="1">
          <mxGeometry height="97.5" width="260" x="300" y="357.5" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-36" parent="TkDbEDfpusLMQh16LgH8-1" style="rounded=0;whiteSpace=wrap;html=1;" value="CHECK cannot look at another table (CUSTOMER/blacklist data) to read the customer’s status." vertex="1">
          <mxGeometry height="97.5" width="260" x="300" y="162.5" as="geometry" />
        </mxCell>
        <mxCell id="Z4EmBJMdyZGiujRd2bhn-35" parent="Z4EmBJMdyZGiujRd2bhn-37" style="rounded=0;whiteSpace=wrap;html=1;" value="Needs a comparison of the new rental’s pickup/return times against all other rows of the same vehicle." vertex="1">
          <mxGeometry height="97.5" width="260" x="300" y="260" as="geometry" />
        </mxCell>
        <mxCell id="WAQ0vC3bLlSf-OjjDzEA-1" parent="1" style="text;whiteSpace=wrap;html=1;fontColor=#393C56;" value="&lt;div style=&quot;color: #cccccc;background-color: #1f1f1f;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #cccccc;&quot;&gt;Asmaa Diab Abdelsamee Ragheb&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #cccccc;&quot;&gt;Group #1 .NET sat &amp;amp; Tue 2pm&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="270" y="-1160" as="geometry" />
        </mxCell>
